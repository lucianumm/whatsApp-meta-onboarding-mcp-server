# Copie os valores para a configuração do MCP no seu cliente (Claude Code / Claude Desktop).
# Nenhuma é obrigatória para as ferramentas de ensino.

# Token de Usuário do Sistema (Nunca expira) — necessário para diagnóstico e ações
META_ACCESS_TOKEN=

# IDs padrão (opcionais; wa_discover_ids descobre)
META_WABA_ID=
META_PHONE_NUMBER_ID=

# Versão da Graph API
META_GRAPH_VERSION=v25.0

# Só para wa_check_app_webhook (token de app)
META_APP_ID=
META_APP_SECRET=
