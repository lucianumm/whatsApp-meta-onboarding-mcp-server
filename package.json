{
  "name": "whatsapp-meta-onboarding-mcp-server",
  "version": "1.1.0",
  "description": "MCP que ensina, passo a passo, o caminho completo para ter um número de WhatsApp (inclusive virtual) na API oficial da Meta — Cloud API e Coexistência — e diagnostica cada etapa na Graph API.",
  "type": "module",
  "bin": { "whatsapp-meta-onboarding-mcp-server": "dist/index.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "docs": "tsx scripts/generate-docs.ts",
    "check": "npm run build && npm run smoke && npm run docs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "whatsapp",
    "whatsapp-cloud-api",
    "whatsapp-business",
    "meta",
    "graph-api",
    "coexistence",
    "onboarding"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucianumm/whatsApp-meta-onboarding-mcp-server.git"
  },
  "homepage": "https://github.com/lucianumm/whatsApp-meta-onboarding-mcp-server#readme",
  "bugs": "https://github.com/lucianumm/whatsApp-meta-onboarding-mcp-server/issues",
  "author": "Lucianum (https://github.com/lucianumm)",
  "license": "MIT",
  "private": true,
  "engines": { "node": ">=20.3" },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
